WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* ~ NEWLINE? }

object = {
    "{" ~ "}"
  | "{" ~ scope_entry* ~ "}"
}

scope_entry = { pair | value }

bracket_substitution = { "[" ~ (!"]" ~ ANY)* ~ "]" }
identifier = ${ (bracket_substitution | (!(" " | "\"" | "}" | "{" | "[" | "]" | "=" | "<" | ">" | "!" | "+" | "\n" | "\r" | "\t" | "#") ~ ANY))+ }

pair = { (identifier | string) ~ sign ~ (value | &("}" | EOI)) }
sign = { ("<=" | ">=" | "!=" | "=" | "<" | ">" | "+") }

value = _{ template | expression | object | string | date | number | named | identifier }
array = { "{" ~ value* ~ "}" }
template = { "[[" ~ template_name ~ "]" ~ scope_entry* ~ "]" }
template_name = @{ (!"]" ~ ANY)+ }
expression = @{ "@" ~ "\\"? ~ "[" ~ (!"]" ~ ANY)* ~ "]" }

string = ${ "\"" ~ inner ~ "\"" }
inner  = @{ char* }
char   = @{
    !("\"" | "\\") ~ ANY
  | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
}

named = { name ~ array }
name = @{ ASCII_ALPHA+ }

date = @{
    ASCII_DIGIT{4} ~ "." ~ ASCII_DIGIT{1, 2} ~ "." ~ ASCII_DIGIT{1, 2} ~ ("." ~ ASCII_DIGIT*)? ~ &boundary
}

number = @{
    ("+" | "-")? ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*) ~ ("." ~ ASCII_DIGIT*)? ~ &boundary
}

boundary = _{ " " | "\t" | "\r" | "\n" | "}" | "#" | EOI }
config = _{ SOI ~ (pair)* ~ EOI }
config_entries = _{ SOI ~ scope_entry* ~ EOI }
